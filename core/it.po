msgid "Number of columns"
msgstr "Numero di colonne"

msgctxt "prefs:template:custom:tablespec:columns:num-columns:tooltip"
msgid ""
"Creates this number of columns to fill in values with this tag. Use this "
"when you have several measurements with the same tag in one image."
msgstr ""
"Crea questo numero di colonne per riempire i valori con questo tag. Usalo "
"quando hai diverse misurazioni con lo stesso bollino in un'immagine."

